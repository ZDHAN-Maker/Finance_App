# =====================================================================
# Salin file ini menjadi .env (untuk lokal) dan isi juga di Vercel
# Project Settings -> Environment Variables (untuk production).
#
# Variabel VITE_* dipakai oleh frontend (aman untuk ter-expose ke
# browser). Variabel lain HANYA boleh ada di server / Vercel, JANGAN
# pernah ditaruh di kode frontend atau di-commit ke git.
# =====================================================================

# --- Frontend (React, aman untuk publik) --------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# --- Backend / API (server only, JANGAN expose ke frontend) -------------
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Telegram Bot (server only) ------------------------------------------
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_WEBHOOK_SECRET=isi-string-acak-yang-sulit-ditebak
# Opsional, hanya dipakai untuk teks instruksi di halaman Pengaturan:
TELEGRAM_BOT_USERNAME=nama_bot_kamu
